        };
        mac_w: mac_w {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            label = "MAC_W";
            bindings = <&kp W>, <&kp LA(W)>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        mac_x: mac_x {
