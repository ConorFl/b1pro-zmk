        };
        mac_2: mac_2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            label = "MAC_2";
            bindings = <&kp N2>, <&kp LA(N2)>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        mac_3: mac_3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            label = "MAC_3";
            bindings = <&kp N3>, <&kp LA(N3)>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        mac_4: mac_4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            label = "MAC_4";
            bindings = <&kp N4>, <&kp LA(N4)>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        mac_5: mac_5 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            label = "MAC_5";
            bindings = <&kp N5>, <&kp LA(N5)>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        mac_6: mac_6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            label = "MAC_6";
            bindings = <&kp N6>, <&kp LA(N6)>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        mac_7: mac_7 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            label = "MAC_7";
            bindings = <&kp N7>, <&kp LA(N7)>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        mac_8: mac_8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            label = "MAC_8";
            bindings = <&kp N8>, <&kp LA(N8)>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        mac_9: mac_9 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            label = "MAC_9";
            bindings = <&kp N9>, <&kp LA(N9)>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        mac_0: mac_0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            label = "MAC_0";
            bindings = <&kp N0>, <&kp LA(N0)>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        mac_lock: mac_lock {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            label = "MAC_LOCK";
            bindings = <&kp DEL>, <&kp LA(LS(L))>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        mac_left_curly_2: mac_left_curly_2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            label = "MAC_LEFT_CURLY_2";
            bindings = <&kp A>, <&prev_tab>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        mac_left_curly_1: mac_left_curly_1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            label = "MAC_LEFT_CURLY_1";
            bindings = <&kp LBKT>, <&mac_left_curly_2>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        mac_right_curly_2: mac_right_curly_2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            label = "MAC_RIGHT_CURLY_2";
            bindings = <&kp A>, <&next_tab>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        mac_right_curly_1: mac_right_curly_1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            label = "MAC_RIGHT_CURLY_1";
            bindings = <&kp RBKT>, <&mac_right_curly_2>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        mac_right_curly: mac_right_curly {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            label = "MAC_RIGHT_CURLY";
            bindings = <&kp RBKT>, <&kp LA(PG_DN)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        mac_meta: mac_meta {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            label = "MAC_META";
            bindings = <&kp RCTRL>, <&mo 3>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        }; 
        morph_BC: morph_BC {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            label = "mBC";
            bindings = <&kp B>, <&kp C>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_RSFT)>;
        };
        morph_ABC: morph_ABC {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            label = "mABC";
            bindings = <&kp A>, <&morph_BC>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
            keep-mods = <(MOD_RCTL)>;
        };
    };

	keymap {
    	compatible = "zmk,keymap";
            //mac
        default_layer {
        bindings = <
          //ESC         //f1                    //f2                //f3                                    //f4                //f5                //f6            //f7            //f8                //f9        //f10       //f11               //f12               //DEL                                              
        &kp ESC     &kp C_BRIGHTNESS_DEC    &kp C_BRIGHTNESS_INC    &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS   &kp  C_AC_MAC_LAUNCH    &kp C_AC_SEARCH     &kp C_AL_LOCK   &kp C_PREVIOUS  &kp C_PLAY_PAUSE    &kp C_NEXT  &kp C_MUTE  &kp C_VOLUME_DOWN   &kp C_VOLUME_UP     &kp DEL  
        &kp GRAVE   &kp N1                  &kp N2                  &kp N3                              &kp N4                  &kp N5              &kp N6          &kp N7          &kp N8              &kp N9      &kp N0      &kp MINUS           &kp EQUAL           &kp BSPC 
        &kp TAB     &kp Q                   &kp W                   &kp E                               &kp R                   &kp T               &kp Y           &kp U           &kp I               &kp O       &kp P       &kp LBKT            &kp RBKT            &kp BSLH      
        &kp CLCK    &kp A                   &kp S                   &kp D                               &kp F                   &kp G               &kp H           &kp J           &kp K               &kp L       &kp SEMI    &kp SQT                         &kp RET                                         
        &kp LSHFT   &kp Z                   &kp X                   &kp C                               &kp V                   &kp B               &kp N           &kp M           &kp COMMA           &kp DOT     &kp FSLH                                    &kp RSHFT 
        &kp LCTRL   &uc LALT                &uc LCMD                       &kp SPACE                                                                                                &uc RCMD            &mo 1       &kp LEFT    &kp UP              &kp DOWN            &kp RIGHT   
        &mo 2       &out OUT_BLE            &out OUT_24G            &out OUT_CHG                        &out OUT_CHGD 
            >;
        };
        //mac
        layer_one  {
        bindings = < 
        &trans      &kp F1                  &kp F2                  &kp F3                              &kp F4                  &kp F5              &kp F6          &kp F7          &kp F8              &kp F9      &kp F10     &kp F11             &kp F12             &trans    
        &trans      &bt_pair_0 0 0          &bt_pair_1 0 0          &bt_pair_2 0 0                      &bt_pair_3 0 0          &trans              &trans          &trans          &trans              &trans      &trans      &trans              &kp C_AC_SEARCH     &trans      
        &trans      &trans                  &trans                  &trans                              &trans                  &trans              &trans          &trans          &kp INS             &trans      &trans      &trans              &trans              &uc LG(LS(N4))
        &trans      &trans                  &trans                  &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans      &trans                      &trans                  
        &trans      &trans                  &trans                  &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans                                  &uc LC(LG(SPACE))
        &trans      &trans                  &trans                         &trans                                                                                                   &kp RCTRL           &trans        &kp HOME   &kp PG_UP   &kp PG_DN    &kp END  
        //
        &none       &none                   &none                   &none                               &none
            >;
        };
        //win - Default Chromebook layer
        layer_two {
 		bindings = <
        &kp ESC 	&kp C_BRIGHTNESS_DEC   &kp C_BRIGHTNESS_INC     &kp F3 	                            &kp F4 	                &kp F5 	            &kp F6 	        &kp C_PREVIOUS  &kp C_PLAY_PAUSE    &kp C_NEXT  &kp C_MUTE  &kp C_VOLUME_DOWN    &kp C_VOLUME_UP 	 &mac_lock    
        &kp GRAVE	&mac_1 	               &mac_2 	                &mac_3 	                            &mac_4 	                &mac_5 	            &mac_6 	        &mac_7 	        &mac_8 	            &mac_9 	     &mac_0     &kp MINUS 	         &kp EQUAL 	         &kp BSPC
        &kp TAB 	&mac_q 	               &mac_w                   &mac_e 	                            &mac_r 	                &mac_t              &mac_y 	        &mac_u 	        &mac_i 	            &mac_o 	     &mac_p 	&mac_left_curly_1    &mac_right_curly_1  &kp BSLH 	 	
        &kp CLCK 	&mac_a 	               &mac_s 	                &mac_d 	                            &mac_f 	                &mac_g 	            &mac_h 	        &mac_j 	        &mac_k 	            &mac_l 	     &kp SEMI 	&kp SQT                      &kp RET
        &kp LSHFT   &mac_z 	               &mac_x 	                &mac_c 	                            &mac_v 	                &mac_b 	            &mac_n 	        &mac_m 	        &kp COMMA           &kp DOT      &kp FSLH                                &kp RSHFT				
        &kp LALT 	&mac_meta              &kp LCTRL                      &kp SPACE              		                                                                            &kp RALT 	        &mo 3 		  &kp LEFT 	 &kp UP      &kp DOWN 	&kp RIGHT 	
        //
        &none       &out OUT_BLE           &out OUT_24G             &out OUT_CHG                        &out OUT_CHGD 
            >;
        };
        //win
        layer_three {
        bindings = < 
                    //f1                    //f2                    //f3                                //f4                        //f5            //f6              //f7            //f8              //f9        //f10           //f11                         //f12                     
        &trans  &kp C_BRIGHTNESS_DEC    &kp C_BRIGHTNESS_INC        &uc LG(TAB)                         &uc LG(E)               &kp C_AC_SEARCH     &uc LG(L)       &kp C_PREVIOUS  &kp C_PLAY_PAUSE    &kp C_NEXT  &kp C_MUTE  &kp C_VOLUME_DOWN           &kp C_VOLUME_UP      &trans   
        &trans  &bt_pair_0 0 0          &bt_pair_1 0 0              &bt_pair_2 0 0                      &bt_pair_3 0 0          &trans              &trans          &trans          &trans              &trans      &trans      &bootloader                 &kp C_AL_CALC        &trans          
        &trans  &trans                  &trans                      &trans                              &trans                  &trans              &trans          &trans          &kp INS             &trans      &trans      &trans                      &trans               &uc LG(LS(S))      
        &trans  &trans                  &trans                      &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans      &trans                              &trans  
        &trans  &trans                  &trans                      &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans                                          &uc LG(DOT) 
        &trans  &trans                  &trans                           &trans                                                                                                     &kp RCTRL           &trans      &kp LA(COMMA)    &kp LA(M)    &kp DOWN   &kp LA(B)    
        //
        &none   &none                   &none                       &none                               &none
            >;
        };
        //win
        layer_four {
        bindings = < 
                    //f1                    //f2                    //f3                                //f4                        //f5            //f6              //f7            //f8              //f9        //f10           //f11                         //f12                     
        &trans  &kp C_BRIGHTNESS_DEC    &kp C_BRIGHTNESS_INC        &uc LG(TAB)                         &uc LG(E)               &kp C_AC_SEARCH     &uc LG(L)       &kp C_PREVIOUS  &kp C_PLAY_PAUSE    &kp C_NEXT  &kp C_MUTE  &kp C_VOLUME_DOWN           &kp C_VOLUME_UP      &trans   
        &trans  &bt_pair_0 0 0          &bt_pair_1 0 0              &bt_pair_2 0 0                      &bt_pair_3 0 0          &trans              &trans          &trans          &trans              &trans      &trans      &trans                      &kp C_AL_CALC        &trans          
        &trans  &trans                  &mac_w                      &trans                              &trans                  &mac_t              &trans          &trans          &kp INS             &trans      &trans      &trans                      &trans               &uc LG(LS(S))      
        &trans  &kp X                   &trans                      &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans      &trans                              &trans  
        &trans  &trans                  &trans                      &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans                                          &uc LG(DOT) 
        &trans  &trans                  &trans                           &trans                                                                                                     &kp RCTRL           &trans      &kp HOME    &kp PG_UP    &kp PG_DN   &kp END    
        //
        &none   &none                   &none                       &none                               &none
            >;
        };
   

    	
    
	};
